          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SpiritualGoal": {
        "type": "object",
        "required": [
          "userId",
          "title"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "example": "665f1c2e8b3a4d0012345678"
          },
          "title": {
            "type": "string",
            "example": "Read the Book of Mormon daily"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Not Started",
              "In Progress",
              "Completed"
            ]
          },
          "targetDate": {
            "type": "string",
            "format": "date",
            "example": "2026-12-31"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "CareerGoal": {
        "type": "object",
        "required": [
          "userId",
          "title"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "example": "665f1c2e8b3a4d0012345678"
          },
          "title": {
            "type": "string",
            "example": "Read the Book of Mormon daily"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Not Started",
              "In Progress",
              "Completed"
            ]
          },
          "targetDate": {
            "type": "string",
            "format": "date",
            "example": "2026-12-31"
          },
          "notes": {
            "type": "string"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 25
          }
        }
      }
    }
  }
}