        ],
        "summary": "Create a CareerGoal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CareerGoal"
              }
            }
          }
        },
        "responses": {
          "201": {
