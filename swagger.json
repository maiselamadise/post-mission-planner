{
  "openapi": "3.0.0",
  "info": {
    "title": "Post-Mission Planner API",
    "version": "1.0.0",
    "description": "Week 5: spiritual goals and career goals. Authentication arrives in Week 6."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/spiritual-goals": {
      "get": {
        "tags": [
          "Spiritual Goals"
        ],
        "summary": "Get all Spiritual Goals",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SpiritualGoal"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": [
          "Spiritual Goals"
        ],
        "summary": "Create a SpiritualGoal",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpiritualGoal"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Validation error"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/spiritual-goals/{id}": {
      "get": {
        "tags": [
          "Spiritual Goals"
        ],
        "summary": "Get one SpiritualGoal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpiritualGoal"
                }
              }
            }
          },
          "400": {
            "description": "Invalid id"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "tags": [
          "Spiritual Goals"
        ],
        "summary": "Update a SpiritualGoal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpiritualGoal"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Updated, no content"
          },
          "400": {
            "description": "Invalid id or validation error"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "tags": [
          "Spiritual Goals"
        ],
        "summary": "Delete a SpiritualGoal",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "24-character MongoDB ObjectId"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "400": {
            "description": "Invalid id"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
