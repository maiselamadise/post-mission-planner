  "components": {
    "schemas": {
      "SpiritualGoal": {
        "type": "object",
        "required": [
          "userId",
          "title"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "example": "665f1c2e8b3a4d0012345678",
            "description": "24-character hex ObjectId of the owner (login arrives in Week 06)"
          },
          "title": {
            "type": "string",
            "example": "Read the Book of Mormon daily"
          },
          "description": {
            "type": "string",
            "example": "Study a chapter each morning before work"
          },
          "status": {
            "type": "string",
            "enum": [
              "Not Started",
              "In Progress",
              "Completed"
            ],
            "example": "In Progress"
          },
          "targetDate": {
            "type": "string",
            "format": "date",
            "example": "2026-12-31"
          },
          "notes": {
            "type": "string",
            "example": "Started the week after returning home"
          }
        }
      },
      "CareerGoal": {
        "type": "object",
        "required": [
          "userId",
          "title"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "example": "665f1c2e8b3a4d0012345678",
            "description": "24-character hex ObjectId of the owner (login arrives in Week 06)"
          },
          "title": {
            "type": "string",
            "example": "Complete a software development certificate"
          },
          "description": {
            "type": "string",
            "example": "Finish the coursework and apply for junior developer roles"
          },
          "status": {
            "type": "string",
            "enum": [
              "Not Started",
              "In Progress",
              "Completed"
            ],
            "example": "In Progress"
          },
          "targetDate": {
            "type": "string",
            "format": "date",
            "example": "2026-12-31"
          },
          "notes": {
            "type": "string",
            "example": "Applying to five companies per week"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "example": 25
          }
        }
      },
      "SpiritualGoalUpdate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Read the Book of Mormon daily"
          },
          "description": {
            "type": "string",
            "example": "Study a chapter each morning before work"
          },
          "status": {
            "type": "string",
            "enum": [
              "Not Started",
              "In Progress",
              "Completed"
            ],
            "example": "In Progress"
          },
          "targetDate": {
            "type": "string",
            "format": "date",
            "example": "2026-12-31"
          },
          "notes": {
            "type": "string",
            "example": "Started the week after returning home"
          }
        },
        "description": "Any subset of fields. userId cannot be changed."
      },
      "SpiritualGoalResponse": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "665f2a9d8b3a4d00aabbccdd"
          },
          "userId": {
            "type": "string",
            "example": "665f1c2e8b3a4d0012345678",
            "description": "24-character hex ObjectId of the owner (login arrives in Week 06)"
          },
          "title": {
            "type": "string",
            "example": "Read the Book of Mormon daily"
          },
          "description": {
            "type": "string",
            "example": "Study a chapter each morning before work"
          },
          "status": {
            "type": "string",
            "enum": [
              "Not Started",
              "In Progress",
              "Completed"
            ],
            "example": "In Progress"
          },
          "targetDate": {
            "type": "string",
            "format": "date",
            "example": "2026-12-31"
          },
          "notes": {
            "type": "string",
            "example": "Started the week after returning home"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CareerGoalUpdate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Complete a software development certificate"
          },
          "description": {
